# Copy this file to .env and fill in what you need.
# The app runs without ANY of these: demo mode + .ics upload + rule-based parsing all work offline.

# Used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# Your local time zone (IANA name).
DEFAULT_TIMEZONE=America/Los_Angeles

# --- Optional: Gemini API for plain-English preferences and plan explanations ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Optional: Google Calendar (see README "Connect Google Calendar") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Only for local development over http://localhost. Never set this in production.
OAUTHLIB_INSECURE_TRANSPORT=1
